# ============================================================
#  C 语言学习仓库 - Git 忽略清单
#  写在这里的文件，Git 会当成"不存在"，永远不会提交。
# ============================================================

# --- 编译产物（C 最容易误提交的就是这些）---
*.o
*.obj
*.exe
a.exe
*.out
*.dSYM/

# --- 调试文件 ---
*.pdb
*.ilk

# --- VSCode / PyCharm 等编辑器的个人配置 ---
.vscode/
.idea/
*.swp

# --- 操作系统生成的垃圾文件 ---
.DS_Store
Thumbs.db
desktop.ini
